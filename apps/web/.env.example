# Frontend build/runtime configuration for apps/web
#
# Set to "true" to run the app fully client-side against Mock Service Worker
# (no backend required). Keep "false" (default) to call the real API through
# the Vite dev proxy (see vite.config.js) / Go backend.

VITE_ENABLE_MOCKS=false
VITE_API_BASE_URL=/api/v1